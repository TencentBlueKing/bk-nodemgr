# Copy this file to testsuite/integration.env to use user-maintained integration services.
# If testsuite/integration.env is absent and NODEMGR_TEST_ENV_SOURCE=auto, testsuite/support uses Docker containers.
# In Docker environments that forbid port publishing, set NODEMGR_TEST_DOCKER_NETWORK=host.

NODEMGR_TEST_ENV_SOURCE=auto
NODEMGR_TEST_DOCKER_NETWORK=bridge

# Docker source uses this image by default. It matches the bundled MongoDB chart app version.
NODEMGR_TEST_MONGO_IMAGE=docker.io/bitnamilegacy/mongodb:6.0.10-debian-11-r8

NODEMGR_TEST_MONGO_ADDRESS=127.0.0.1:27017
# Mongo integration tests create isolated databases with generated suffixes, so root/admin is recommended.
NODEMGR_TEST_MONGO_USER=root
NODEMGR_TEST_MONGO_PASSWORD=password
NODEMGR_TEST_MONGO_AUTH_SOURCE=admin
NODEMGR_TEST_MONGO_AUTH_MECHANISM=SCRAM-SHA-256
NODEMGR_TEST_MONGO_DATABASE=bk_nodemgr_test

# Docker source uses the legacy repository variant of the bundled Redis chart image by default.
NODEMGR_TEST_REDIS_IMAGE=docker.io/bitnamilegacy/redis:7.0.12-debian-11-r34

NODEMGR_TEST_REDIS_ADDRESS=127.0.0.1:6379
NODEMGR_TEST_REDIS_USERNAME=
NODEMGR_TEST_REDIS_PASSWORD=
NODEMGR_TEST_REDIS_DB=0

# Docker source uses a pinned standalone CMDB quick-start image by default.
NODEMGR_TEST_CMDB_IMAGE=ccr.ccs.tencentyun.com/bk.io/cmdb-standalone@sha256:1987ff3dcf56debc6961d16e5669404c02816e7e31e7f7711fb3e054a1f06302

# Env source connects to this user-maintained disposable CMDB apiserver origin.
# Never point package integration tests at production or non-disposable CMDB services.
# Do not append /api/v3; the CMDB client appends it.
# Docker source derives the endpoint from the started container instead.
NODEMGR_TEST_CMDB_ENDPOINT=http://127.0.0.1:8080
# Docker source rewrites /data/run.sh with this host IP before starting CMDB.
# Bridge mode defaults to 0.0.0.0 when empty; host mode defaults to 127.0.0.1.
NODEMGR_TEST_CMDB_HOST_IP=
NODEMGR_TEST_CMDB_SUPPLIER_ACCOUNT=0
# Docker source defaults to admin when this value is empty; env source requires an explicit value.
NODEMGR_TEST_CMDB_VIRTUAL_USER=
# Optional legacy Bk-App-Code header for standalone apiserver integration tests.
NODEMGR_TEST_CMDB_APP_CODE=
# Defaults to default when empty.
NODEMGR_TEST_CMDB_TENANT_ID=
