# BlueKing API Gateway Configuration
# Notice Center API endpoint
BK_APIGW_ENDPOINT="http://bkapi.example.com/api/bk-notice/prod"

# API Gateway Authentication Header (JSON format)
# Contains app_code, app_secret, and username for authentication
BK_APIGW_AUTHHEADER={"bk_app_code": "bk-nodemgr", "bk_app_secret": "your-app-secret-here", "bk_username": "admin"}
