application:
  enabled: false
backend:
  enabled: false
file:
  enabled: false

etcd:
  enabled: false
redis:
  enabled: false
mongodb:
  enabled: false

{{- $ingress := deepCopy (dig "global" "ingress" dict .Values) }}
{{- $ingressEnabled := dig "enabled" false $ingress }}
{{- $ingressClassName := dig "className" "" $ingress }}
{{- $ingressDomain := dig "domain" "" $ingress }}
{{- $grafanaPath := dig "grafanaPath" "/grafana" $ingress }}
{{- $tlsSecretName := dig "tlsSecretName" "" $ingress }}

{{- $monitoringEnabled := dig "monitoring" "enabled" true .Values }}
tempo:
  enabled: {{ $monitoringEnabled }}
{{- $traceExporters := dig "opentelemetryGateway" "exporters" dict .Values }}
{{- if hasKey $traceExporters "otlp/tempo" }}
{{- fail "opentelemetryGateway.exporters: otlp/tempo is reserved for embedded Tempo" }}
{{- end }}
opentelemetryGateway:
  enabled: {{ or $monitoringEnabled (not (empty $traceExporters)) }}
  {{- if $traceExporters }}
  alternateConfig:
    receivers:
      otlp:
        protocols:
          grpc:
            endpoint: 0.0.0.0:4317
          http:
            endpoint: 0.0.0.0:4318
    processors:
      memory_limiter:
        limit_mib: 512
        spike_limit_mib: 128
        check_interval: 5s
      batch: {}
    exporters:
      {{- if $monitoringEnabled }}
      otlp/tempo:
        endpoint: '{{`{{ include "bk-nodemgr.tempo.otlpGrpcEndpoint" . }}`}}'
        tls:
          insecure: true
        sending_queue:
          enabled: true
        retry_on_failure:
          enabled: true
      {{- end }}
{{ $traceExporters | toYaml | indent 6 }}
    extensions:
      health_check:
        endpoint: 0.0.0.0:13133
    service:
      extensions:
        - health_check
      pipelines:
        traces:
          receivers:
            - otlp
          processors:
            - memory_limiter
            - batch
          exporters:
            {{- if $monitoringEnabled }}
            - otlp/tempo
            {{- end }}
            {{- range $name := keys $traceExporters | sortAlpha }}
            - {{ $name | quote }}
            {{- end }}
  {{- end }}
prometheus:
  enabled: {{ $monitoringEnabled }}
  nodemgrScrape:
    namespaces:
      application: {{ .Values.namespaces.application | quote }}
      backend: {{ .Values.namespaces.backend | quote }}
      file: {{ .Values.namespaces.file | quote }}
  server:
    persistentVolume:
      enabled: true
      storageClass: ""
      size: 8Gi
grafana:
  enabled: {{ $monitoringEnabled }}
  rootURL: https://{{ $ingressDomain }}{{ $grafanaPath }}/
  persistence:
    enabled: true
    storageClassName: ""
    size: 1Gi
  ingress:
    enabled: {{ $ingressEnabled }}
    ingressClassName: {{ $ingressClassName | quote }}
    hosts:
      - {{ $ingressDomain | quote }}
    path: {{ $grafanaPath | quote }}
    pathType: Prefix
    {{- if $tlsSecretName }}
    tls:
      - secretName: {{ $tlsSecretName | quote }}
        hosts:
          - {{ $ingressDomain | quote }}
    {{- end }}
loki:
  enabled: {{ $monitoringEnabled }}
  singleBinary:
    persistence:
      enabled: true
      storageClass: ""
      size: 8Gi
alloy:
  enabled: {{ $monitoringEnabled }}
  nodemgrNamespaces:
    - {{ .Values.namespaces.application | quote }}
    - {{ .Values.namespaces.backend | quote }}
    - {{ .Values.namespaces.file | quote }}
pyroscope:
  enabled: {{ $monitoringEnabled }}
  pyroscope:
    persistence:
      enabled: true
      storageClassName: ""
      size: 10Gi
