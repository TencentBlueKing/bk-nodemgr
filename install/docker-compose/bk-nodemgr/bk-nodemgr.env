# ETCD configs.
BK_NODEMGR_ETCD_PORT=2379
BK_NODEMGR_ETCD_PEER_PORT=2380
BK_NODEMGR_ETCD_PASSWORD="password"

# Redis configs.
# type: standalone, sentinel, cluster
BK_NODEMGR_REDIS_TYPE="standalone"
BK_NODEMGR_REDIS_PORT=6379
BK_NODEMGR_REDIS_PASSWORD="password"
# masterName is required for sentinel mode
# BK_NODEMGR_REDIS_MASTER_NAME="mymaster"

# Mongodb configs.
BK_NODEMGR_MONGODB_APPNAME="bk-nodemgr"
BK_NODEMGR_MONGODB_PORT=27017
BK_NODEMGR_MONGODB_PASSWORD="password"

# common configs.
BK_NODEMGR_ADVERTISE_IPV4=""
BK_NODEMGR_SERVICE_IMAGE="mirrors.example.com/bk-nodemgr-server:latest"
BK_NODEMGR_APPCODE="bk-nodemgr"
BK_NODEMGR_APPSECRET=""
BK_NODEMGR_SERVICE_ENDPOINT=""
BK_NODEMGR_CMDB_ENDPOINT=""
BK_NODEMGR_USER_MANAGER_ENDPOINT=""
BK_NODEMGR_GSE_ENDPOINT=""
BK_NODEMGR_PLUGIN_SLOT_ID=0
BK_NODEMGR_PLUGIN_SLOT_TOKEN=""
BK_NODEMGR_REPO_ENDPOINT=""
BK_NODEMGR_REPO_PROJECT_ID=""
BK_NODEMGR_REPO_REPO_NAME=""
BK_NODEMGR_REPO_ACCESS_KEY=""
BK_NODEMGR_REPO_SECRET_KEY=""
BK_NODEMGR_VIRTUAL_USER="admin"

# Application configs.
BK_NODEMGR_APPLICATION_LOGIN_URL=""
BK_NODEMGR_APPLICATION_BKLOGIN_ENDPOINT=""
BK_NODEMGR_APPLICATION_AUTH_TYPE="bk_token"
BK_NODEMGR_APPLICATION_USER_WEB_URL=""
BK_NODEMGR_APPLICATION_DOMAIN=""
BK_NODEMGR_APPLICATION_DOCS_CENTER_URL=""
BK_NODEMGR_APPLICATION_NAV_OPEN_SOURCE_URL=""
BK_NODEMGR_APPLICATION_WINDOWS_WMI_PORT_DEFAULT=445
BK_NODEMGR_APPLICATION_UNIX_SSH_PORT_DEFAULT=36000
BK_NODEMGR_APPLICATION_INFO_PORT=28000
BK_NODEMGR_APPLICATION_ADMIN_PORT=28001
BK_NODEMGR_APPLICATION_ADMIN_AUTH_IDENTITY="rest-server"
BK_NODEMGR_APPLICATION_BASIC_PORT=28002
BK_NODEMGR_APPLICATION_INFO_BIND_IP="127.0.0.1"
BK_NODEMGR_APPLICATION_LOG_LEVEL="INFO"

# Backend configs.
BK_NODEMGR_BACKEND_SYSTEM_ENV="gse2"
BK_NODEMGR_BACKEND_SYSTEM_EDITION="ce"
BK_NODEMGR_BACKEND_ENCRYPT_KEY=""
BK_NODEMGR_BACKEND_INFO_PORT=28100
BK_NODEMGR_BACKEND_ADMIN_PORT=28101
BK_NODEMGR_BACKEND_ADMIN_AUTH_IDENTITY="rest-server"
BK_NODEMGR_BACKEND_BASIC_PORT=28102
BK_NODEMGR_BACKEND_BASIC_AUTH_IDENTITY="api-gateway"
BK_NODEMGR_BACKEND_CALLBACK_PORT=28103
BK_NODEMGR_BACKEND_PROXY_PORT=28104
BK_NODEMGR_BACKEND_WORKFLOW_WORKER_NUM=4096
BK_NODEMGR_BACKEND_INFO_BIND_IP="127.0.0.1"
BK_NODEMGR_BACKEND_LOG_LEVEL="INFO"

# File configs.
BK_NODEMGR_FILE_INFO_PORT=28200
BK_NODEMGR_FILE_ADMIN_PORT=28201
BK_NODEMGR_FILE_ADMIN_AUTH_IDENTITY="rest-server"
BK_NODEMGR_FILE_BASIC_PORT=28202
BK_NODEMGR_FILE_BASIC_AUTH_IDENTITY="rest-server"
BK_NODEMGR_FILE_DOWNLOAD_PORT=28203
BK_NODEMGR_FILE_MOUNT_HOST_DIR=/data/bk-nodemgr-file-mount/
BK_NODEMGR_FILE_INFO_BIND_IP="127.0.0.1"
BK_NODEMGR_FILE_LOG_LEVEL="INFO"

# APIGW sync configs.
BK_NODEMGR_APIGW_URL_TMPL="https://{api_name}.apigw.example.com"
BK_NODEMGR_APP_TENANT_ID="default"
BK_NODEMGR_APIGW_RELEASE_STAGES="stage"

# Application JWT configs.
BK_NODEMGR_APPLICATION_ADMINSERVER_JWT_SYMMETRIC_KEY="bk-nodemgr-application-admin-server-jwt-secret"

# Backend JWT configs.
BK_NODEMGR_BACKEND_ADMINSERVER_JWT_SYMMETRIC_KEY="bk-nodemgr-backend-admin-server-jwt-secret"
BK_NODEMGR_BACKEND_BASICSERVER_JWT_PUBLIC_KEY_PEM=""

# File JWT configs.
BK_NODEMGR_FILE_ADMINSERVER_JWT_SYMMETRIC_KEY="bk-nodemgr-file-admin-server-jwt-secret"
BK_NODEMGR_FILE_BASICSERVER_JWT_SYMMETRIC_KEY="bk-nodemgr-file-basic-server-jwt-secret"
