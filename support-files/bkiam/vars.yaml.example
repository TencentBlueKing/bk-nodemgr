# IAM Migration Variables Configuration
# Copy this file to vars.yaml and fill in your values
#
# Usage:
#   cd support-files/bkiam
#   ./iam-render -t templates -v vars.yaml -o output

# System configuration
system:
  id: "bk-nodemgr"
  clients: "bk-nodemgr"

# Provider configuration for IAM callbacks
provider:
  # The URL where IAM will call back to bk-nodemgr for resource queries
  # Example: http://bk-nodemgr.example.com/api/v1/iam
  host: ""

  # Authentication method for provider callbacks
  # Options: basic, none
  # Default: basic
  auth: "basic"

  # Path for IAM callbacks.
  path: "/api/v3/iam/v3/resource"

# CMDB configuration for business resource authorization
# These values reference CMDB's IAM resource definitions
cmdb:
  # CMDB system ID registered in IAM
  system_id: "bk_cmdb"

  # Resource definitions from CMDB
  resource:
    # Business (biz) resource configuration
    biz:
      # Resource type ID for business in CMDB
      resource_type_id: "biz"
      # Instance selection ID for business picker in IAM
      instance_selection_id: "business"
