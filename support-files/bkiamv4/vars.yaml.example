# IAM V4 Migration Variables Configuration
# Copy this file to vars.yaml and fill in your values.
#
# Usage (from support-files/bkiamv4):
#   ./render/iam-render -t templates -v vars.yaml -o output

system:
  # Creation requires id, name, and clients. Include your own app code in clients.
  id: "bk_nodemgr"
  name: "节点管理"
  description: "蓝鲸节点管理系统, 提供节点管理, 插件管理等功能"
  # IAM V4 expects an array of app codes, not the IAM V3 comma-separated string.
  clients:
    - "bk-nodemgr"
  callback_url: "https://bk-nodemgr.example.com/api/v3/iam/v4/resource"
  # Managers are optional and omitted from the default migration.
