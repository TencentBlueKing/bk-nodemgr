{
  "name": "release-version-alignment",
  "version": "2.1.0",
  "description": "Fast path for bk-nodemgr complete release preparation and release version alignment checks",
  "dependencies": {
    "repo_constraints": [
      "install/AGENTS.md",
      ".github/workflows/pr-title-lint.yml",
      ".github/labeler.yml"
    ],
    "modes": {
      "complete_release": {
        "target_files": [
          "apigw/definition.yaml",
          "apigw/resources.yaml",
          "install/helm/bk-nodemgr/Chart.yaml",
          "install/helm/bk-nodemgr/values.yaml",
          "install/helm/mock-server/Chart.yaml",
          "install/helm/mock-server/values.yaml",
          "support-files/changelog/en/<version>_<date>.md",
          "support-files/changelog/zh/<version>_<date>.md"
        ],
        "target_fields": {
          "apigw/definition.yaml": ["release.version", "release.comment"],
          "install/helm/bk-nodemgr/Chart.yaml": ["version", "appVersion"],
          "install/helm/bk-nodemgr/values.yaml": [
            "image.tag",
            "apiManagerImage.tag",
            "apigwSync.config.release.version",
            "apigwSync.config.release.comment"
          ],
          "install/helm/mock-server/Chart.yaml": ["version", "appVersion"],
          "install/helm/mock-server/values.yaml": ["image.tag"],
          "support-files/changelog/{en,zh}/<version>_<date>.md": ["version heading"]
        }
      },
      "helm_followup": {
        "target_files": [
          "install/helm/bk-nodemgr/Chart.yaml",
          "install/helm/bk-nodemgr/values.yaml",
          "install/helm/mock-server/Chart.yaml",
          "install/helm/mock-server/values.yaml"
        ],
        "target_fields": {
          "Chart.yaml": ["version", "appVersion"],
          "install/helm/bk-nodemgr/values.yaml": ["image.tag", "apiManagerImage.tag"],
          "install/helm/mock-server/values.yaml": ["image.tag"]
        },
        "allows_subset": true
      }
    },
    "base_branch": "master",
    "fork_upstream_pattern": {
      "fork": "zouxingyuks/bk-nodemgr",
      "upstream": "TencentBlueKing/bk-nodemgr"
    }
  },
  "scope": {
    "allowed_operations": [
      "complete release version preparation",
      "version alignment check",
      "minimal PR creation for missing alignment",
      "release readiness confirmation"
    ],
    "forbidden_operations": [
      "broad release-process explanation",
      "tag surgery or tag movement",
      "pipeline debugging",
      "helm template modification",
      "chart dependency changes",
      "non-version helm changes"
    ]
  },
  "safety_rules": {
    "issue_reference": {
      "default": "refs #...",
      "auto_close_only_when": "user explicitly requests auto-close after merge"
    },
    "branch_cleanliness": {
      "clean_branch_required_when": "unrelated commits exist or working tree has non-alignment changes",
      "clean_branch_base": "origin/master"
    },
    "scope_validation": {
      "stop_and_ask_when": [
        "target version unclear",
        "reference commit unclear",
        "mode unclear",
        "file scope exceeds mode-specific target files",
        "request mixes version alignment with unrelated changes"
      ]
    },
    "api_gateway_version_rule": "For complete release PRs, apigw release.version/comment and apigwSync.config.release.version/comment equal the target system version without the leading v; apigw/resources.yaml remains conditional on gateway-visible resource changes"
  },
  "verification": {
    "script": "scripts/verify-alignment.sh",
    "checks": [
      "file scope: complete release files or Helm-only allowed subset",
      "version alignment: all touched version/appVersion/image.tag/apiManagerImage.tag fields match target",
      "API Gateway metadata: complete releases require definition and values release.version/comment to equal the target version without v",
      "diff sanity: no template, dependency, or runtime setting changes",
      "changelog: complete release has both support-files/changelog/en and support-files/changelog/zh target version files",
      "gateway resource sync: gateway-visible backend swagger changes require apigw/resources.yaml in the same version window"
    ],
    "changelog_generation": {
      "skill": "changelog-doc",
      "paths": [
        "support-files/changelog/en/<version>_<date>.md",
        "support-files/changelog/zh/<version>_<date>.md"
      ],
      "required_before_pr_for_complete_release": true,
      "user_confirmation_required": true
    }
  },
  "output_format": {
    "helm_followup_commit_message": "feat: bump {chart-name} helm chart to {version} --issue=#{issue-number}",
    "single_lagging_field_commit_message": "chore: bump bk-nodemgr-apigw-sync image to {version}",
    "complete_release_pr_title": "feat: bump release version to {version} --issue=#{issue-number}",
    "helm_followup_pr_title": "feat: bump helm release version to {version} --issue=#{issue-number}",
    "pr_body": "## Summary\n- align release version to {version}\n\nrefs #{issue-number}",
    "branch_name": "pr/helm-release-{version-suffix}"
  },
  "references": [
    "references/example-pr.md",
    "references/tag-workflow.md",
    "install/AGENTS.md",
    ".github/workflows/pr-title-lint.yml",
    ".github/labeler.yml",
    "create-github-pr/SKILL.md"
  ]
}
