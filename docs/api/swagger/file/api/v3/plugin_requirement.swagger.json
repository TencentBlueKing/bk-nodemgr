  "paths": {
    "/api/v3/plugin/requirement/create": {
      "post": {
        "summary": "创建归属于指定插件的依赖文件，业务名称在当前租户的同一插件内唯一。",
        "operationId": "PluginRequirement_PluginRequirementCreate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3PluginRequirementCreateResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3PluginRequirementCreateReq"
            }
          }
        ],
        "tags": [
          "PluginRequirement"
        ]
      }
    },
    "/api/v3/plugin/requirement/download": {
      "get": {
        "summary": "按 UUID 下载当前租户的插件依赖文件正文。",
        "operationId": "PluginRequirement_PluginRequirementDownload",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v3PluginRequirementDownloadResp"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v3PluginRequirementDownloadResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "requirement_file_id",
            "description": "文件记录的 UUID，通过查询参数传递。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "PluginRequirement"
        ]
      }
    },
    "/api/v3/plugin/requirement/get": {
      "post": {
