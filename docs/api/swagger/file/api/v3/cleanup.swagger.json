  "paths": {
    "/api/v3/cleanup/export": {
      "post": {
        "summary": "清理当前租户的过期导出文件。",
        "description": "同步清理当前租户未被导出记录引用、且最后修改时间早于执行时间前两个自然月的导出文件；遇错即停，失败后可直接重试。",
        "operationId": "Cleanup_CleanupExport",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3CleanupExportResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3CleanupExportReq"
            }
          }
        ],
        "tags": [
          "Cleanup"
        ]
      }
    },
    "/api/v3/cleanup/release": {
      "post": {
        "summary": "清理当前租户指定类型的过期安装包文件。",
        "description": "同步清理当前租户指定类型下未被安装包版本引用、且最后修改时间早于执行时间前两个自然月的安装包文件；遇错即停，失败后可直接重试。",
        "operationId": "Cleanup_CleanupRelease",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3CleanupReleaseResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3CleanupReleaseReq"
            }
          }
        ],
        "tags": [
          "Cleanup"
        ]
      }
    },
    "/api/v3/cleanup/upload": {
      "post": {
        "summary": "清理当前租户指定类别的过期上传文件。",
        "description": "同步清理当前租户指定类别下未被上传记录引用、且最后修改时间早于执行时间前两个自然月的上传文件；遇错即停，失败后可直接重试。",
        "operationId": "Cleanup_CleanupUpload",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3CleanupUploadResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3CleanupUploadReq"
            }
          }
        ],
        "tags": [
          "Cleanup"
        ]
      }
    }
  },
