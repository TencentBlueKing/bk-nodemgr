  "paths": {
    "/api/v3/excel/agent_install_template/download": {
      "post": {
        "summary": "下载 Agent 安装 Excel 模板。",
        "operationId": "Excel_ExcelDownloadAgentInstallTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3FileChunk"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3ExcelDownloadAgentInstallTemplateReq"
            }
          }
        ],
        "tags": [
          "Excel"
        ]
      }
    },
    "/api/v3/excel/agent_install_template/parse": {
      "post": {
        "summary": "解析 Agent 安装 Excel 模板，逐行返回安装参数。",
        "description": "模板由下载接口生成，需保持表头与必填标注一致；单行解析失败会返回该行的\n错误原因，不影响其他行。",
        "operationId": "Excel_ExcelParseAgentInstallTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3ExcelParseAgentInstallTemplateResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3ExcelParseAgentInstallTemplateReq"
            }
          }
        ],
        "tags": [
          "Excel"
        ]
      }
    },
    "/api/v3/excel/ops_template/download": {
