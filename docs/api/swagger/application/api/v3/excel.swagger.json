      }
    },
    "/api/v3/excel/ops_template/parse": {
      "post": {
        "summary": "解析带外设置 Excel 模板，按业务、管控区域与内网 IP\n匹配已有主机，并解析主控机与带外字段。",
        "description": "逐行返回解析结果：成功的行携带主机与主控机 ID，失败的行携带行号与错误\n原因，单行失败不影响其他行。",
        "operationId": "Excel_ExcelParseOpsTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3ExcelParseOpsTemplateResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3ExcelParseOpsTemplateReq"
            }
          }
        ],
        "tags": [
          "Excel"
        ]
      }
    },
