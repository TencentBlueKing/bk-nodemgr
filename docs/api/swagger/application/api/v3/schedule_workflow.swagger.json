    "/api/v3/schedule/workflow/interval/update": {
      "post": {
        "summary": "修改定时工作流的周期配置，由现有调度同步机制异步生效；不重置上次触发时间或中止正在执行的实例。",
        "operationId": "ScheduleWorkflow_ScheduleWorkflowUpdateInterval",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3ScheduleWorkflowUpdateIntervalResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3ScheduleWorkflowUpdateIntervalReq"
            }
          }
        ],
        "tags": [
          "ScheduleWorkflow"
        ]
      }
    },
