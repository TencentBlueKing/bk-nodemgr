  "paths": {
    "/api/v3/version_log/changelog/{version}": {
      "get": {
        "summary": "Detail returns the changelog for a specific version.",
        "operationId": "VersionLog_Detail",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3VersionLogDetailResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "version",
            "description": "version is the version identifier to fetch (e.g. \"v3.0.1-alpha.17\").",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "VersionLog"
        ]
      }
    },
    "/api/v3/version_log/version_logs_list": {
      "get": {
        "summary": "List returns all available version changelogs.",
        "operationId": "VersionLog_List",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3VersionLogsListResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "VersionLog"
        ]
      }
    }
  },
