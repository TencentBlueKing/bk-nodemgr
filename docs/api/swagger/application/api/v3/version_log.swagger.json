{
  "swagger": "2.0",
  "info": {
    "title": "version_log.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "VersionLog"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v3/version_log/changelog/{version}": {
      "get": {
        "summary": "获取指定版本的更新日志。",
        "operationId": "VersionLog_Detail",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3VersionLogDetailResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "version",
            "description": "version is the version identifier to fetch (e.g. \"v3.0.1-alpha.17\").",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "VersionLog"
        ]
      }
    },
    "/api/v3/version_log/overview/{version}": {
      "get": {
        "summary": "查询指定大版本的概览文档；当前语言没有对应文档时返回记录不存在。",
        "operationId": "VersionLog_OverviewDetail",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3VersionOverviewDetailResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "version",
            "description": "三段基础版本号，例如 v3.0.1，不包含 alpha、beta 或 release 后缀。",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "VersionLog"
        ]
      }
    },
    "/api/v3/version_log/overview_list": {
      "get": {
        "summary": "查询当前语言下已有的大版本概览列表及当前所属大版本。",
        "operationId": "VersionLog_OverviewList",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3VersionOverviewListResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "VersionLog"
        ]
      }
    },
    "/api/v3/version_log/version_logs_list": {
      "get": {
        "summary": "查询所有可用版本的更新日志列表。",
        "operationId": "VersionLog_List",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3VersionLogsListResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "VersionLog"
        ]
      }
    }
  },
