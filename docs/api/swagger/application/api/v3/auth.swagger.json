          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "$ref": "#/definitions/v3Error"
        },
        "permission": {
          "$ref": "#/definitions/v3Permission"
        },
        "data": {
          "$ref": "#/definitions/v3AuthVerifyRespData"
        }
      },
      "description": "AuthVerifyResp describes the HTTP response body for auth verification."
    },
    "v3AuthVerifyRespData": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3AuthVerifyResult"
          }
        }
      }
    },
    "v3AuthVerifyResult": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "action is the IAM action that was checked."
        },
        "authorized": {
          "type": "boolean",
          "description": "authorized indicates whether the user has this permission."
        }
      },
      "description": "AuthVerifyResult holds the authorization result for a single action."
    },
    "v3AuthorizedItem": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "action is the IAM action identifier (e.g. \"agent_view\",\n\"networkarea_create\")."
        },
        "resource_type": {
          "type": "string",
          "description": "resource_type is the resource type to query authorized scope for (e.g.\n\"biz\", \"networkarea\")."
        }
      },
      "description": "AuthorizedItem describes a single action-resource type pair for querying\nauthorized scope."
    },
    "v3AuthorizedReq": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3AuthorizedItem"
          },
          "description": "items lists the action-resource type pairs to query authorized scope\nfor."
        }
      },
      "description": "AuthorizedReq describes the HTTP request body for querying authorized\nresource scope."
    },
    "v3AuthorizedResp": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "$ref": "#/definitions/v3Error"
        },
        "permission": {
          "$ref": "#/definitions/v3Permission"
        },
        "data": {
          "$ref": "#/definitions/v3AuthorizedRespData"
        }
      },
      "description": "AuthorizedResp describes the HTTP response body for authorized scope\nquery."
    },
    "v3AuthorizedRespData": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3AuthorizedResult"
          }
        }
      }
    },
    "v3AuthorizedResult": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "action is the IAM action that was queried."
        },
        "resource_type": {
          "type": "string",
          "description": "resource_type is the resource type that was queried."
        },
        "is_any": {
          "type": "boolean",
          "description": "is_any indicates whether the user has unrestricted access to all\nresources of this type."
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3AuthResource"
          },
          "description": "resources lists the authorized resource instances. Empty when is_any is\ntrue."
        }
      },
      "description": "AuthorizedResult holds the authorized scope for a single action-resource\ntype pair."
    },
    "v3Error": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
