        },
        "apply_url": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3Action"
          }
        }
      }
    },
    "v3RelatedResourceType": {
      "type": "object",
      "properties": {
        "system_id": {
          "type": "string"
        },
        "system_name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "type_name": {
          "type": "string"
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3ResourceNode"
          }
        }
      }
    },
    "v3ResourceNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "type_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
