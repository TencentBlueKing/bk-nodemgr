          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3RelatedResourceType"
          }
        }
      }
    },
    "v3AuthResource": {
      "type": "object",
      "properties": {
        "system_id": {
          "type": "string",
          "description": "system_id is the IAM system that owns this resource (e.g. \"bk_cmdb\" or\n\"bk_nodemgr\")."
        },
        "type": {
          "type": "string",
          "description": "type is the resource type identifier (e.g. \"biz\", \"networkarea\")."
        },
        "id": {
          "type": "string",
          "description": "id is the resource instance ID."
        }
      },
      "description": "AuthResource describes a single resource instance for authorization checks."
    },
    "v3AuthVerifyItem": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "action is the IAM action identifier (e.g. \"agent_view\",\n\"networkarea_create\")."
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3AuthResource"
          },
          "description": "resources lists the resources to check for this action. Empty for\naction-level checks."
        }
      },
      "description": "AuthVerifyItem describes a single action-resource pair for permission\nverification."
    },
    "v3AuthVerifyReq": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3AuthVerifyItem"
          },
          "description": "items lists the action-resource pairs to verify permissions for."
        }
      },
      "description": "AuthVerifyReq describes the HTTP request body for auth verification."
    },
    "v3AuthVerifyResp": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
