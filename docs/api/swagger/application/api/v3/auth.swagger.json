{
  "swagger": "2.0",
  "info": {
    "title": "auth.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "Auth"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v3/auth/authorized": {
      "post": {
        "summary": "Authorized queries the authorized resource scope for the requested\naction-resource type pairs.",
        "operationId": "Auth_Authorized",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3AuthorizedResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "AuthorizedReq describes the HTTP request body for querying authorized\nresource scope.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3AuthorizedReq"
            }
          }
        ],
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v3/auth/verify": {
      "post": {
        "summary": "Verify checks whether the current user has permissions for the requested\nresources.",
        "operationId": "Auth_Verify",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3AuthVerifyResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "AuthVerifyReq describes the HTTP request body for auth verification.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3AuthVerifyReq"
            }
          }
        ],
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "definitions": {
    "ErrorDetails": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "protobufAny": {
      "type": "object",
