      "post": {
        "summary": "NodeOpsHistoryDetail retrieves all archived snapshots for an operation\nwithin the caller's permission scope.",
        "operationId": "Ops_NodeOpsHistoryDetail",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3NodeOpsHistoryDetailResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "NodeOpsHistoryDetailReq describes the snapshot retrieval request for all node\nroles.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3NodeOpsHistoryDetailReq"
            }
          }
        ],
        "tags": [
          "Ops"
        ]
      }
    },
    "/api/v3/node/ops/history/list": {
      "post": {
        "summary": "NodeOpsHistoryList lists operations across agent and proxy roles within\nthe caller's permission scope.",
