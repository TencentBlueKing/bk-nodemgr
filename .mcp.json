{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "serena": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "cd \"${CURSOR_WORKSPACE:-$(pwd)}\" && uvx --from git+https://github.com/oraios/serena serena start-mcp-server --context ide-assistant --project \"${CURSOR_WORKSPACE:-$(pwd)}\""
      ],
      "env": {}
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    }
  }
}